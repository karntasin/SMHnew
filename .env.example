APP_NAME=SMH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain, LOG_LEVEL=warning

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=react_stater_kits
# แนะนำ: ใช้ user แยกสิทธิ์จาก scripts/mysql/create-least-privilege-users.sql (อย่าใช้ root/sa ใน production)
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LINE Login + Messaging
LINE_INTEGRATION_ENABLED=true
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_OAUTH_REDIRECT=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_WELCOME_MESSAGE=
LINE_OA_ADD_FRIEND_URL=

# Telegram — แจ้งเตือนการใช้ยาตาม eGFR เข้ากลุ่ม
# 1) สร้างบอทที่ @BotFather ได้ token
# 2) เชิญบอทเข้ากลุ่ม แล้วปิด privacy (BotFather → /setprivacy → Disable) หรือให้บอทเป็น admin
# 3) หา chat_id กลุ่ม (เช่น ใช้ @userinfobot หรือ getUpdates หลังส่งข้อความในกลุ่ม)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EGFR_ALERTS_ENABLED=false
# 0 = เฉพาะวันนี้ | 1 = ย้อนหลัง 1 วัน (รวมวันนี้ = 2 วัน)
TELEGRAM_EGFR_ALERTS_LOOKBACK_DAYS=0
# contraindicated,alert,dose_exceeded,missing_egfr
TELEGRAM_EGFR_ALERTS_SEVERITIES=contraindicated,alert,dose_exceeded
TELEGRAM_EGFR_ALERTS_MAX_ITEMS=20
# per_item = แจ้งทีละใบสั่งเมื่อเข้าเงื่อนไข | digest = สรุปรวม
TELEGRAM_EGFR_ALERTS_MODE=per_item

# แจ้งเตือนสต็อกยาต่ำ/หมด/ใกล้หมดอายุ
TELEGRAM_STOCK_ALERTS_ENABLED=false

# HOSxP desktop notify — เขียนเฉพาะตาราง ksklog (NOTIFYMESSAGE)
# ผู้ส่งต้องเป็น session จริงใน onlineuser (ใส่ IP เครื่องที่ login อยู่)
HOSXP_NOTIFY_ENABLED=false
HOSXP_NOTIFY_SENDER_COMPUTER=

# FSHH Chat (Cloudflare Worker) — ใช้ LINE user id เดียวกับ LINE Login
# ถ้า LINE_LOGIN_CHANNEL_ID ไม่ใช่ช่องเดียวกับ LIFF 2011190976 ข้อมูลจะจับคู่ไม่ได้
FSHH_CHAT_WORKER_URL=https://polished-river-f1bb.karntasin5.workers.dev
FSHH_CHAT_SYNC_SECRET=
FSHH_CHAT_LIFF_URL=https://liff.line.me/2011190976-nGVbTYZD
# ผู้ช่วย AI ในแชทใช้ Cloudflare Workers AI (ฟรี 10,000 neurons/วัน) จาก snapshot ที่คำสั่ง fshh-chat:sync-ai ส่งไป ไม่ดึง HOSxP
# ถ้า PHP Windows ขึ้น SSL error 60 ให้ใส่ false
FSHH_CHAT_VERIFY_SSL=true

# HTTPS tunnel — quick = *.trycloudflare.com ชั่วคราว | named = subdomain ถาวรของโดเมนคุณ
TUNNEL_DRIVER=cloudflare
CLOUDFLARED_BIN=
CLOUDFLARE_TUNNEL_MODE=quick
# ตัวอย่าง: smh.hospital.go.th (มาจาก Zero Trust → Tunnels → Public Hostname)
CLOUDFLARE_PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_CONFIG=deploy/cloudflare/config.yml
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_BIN=
NGROK_ADDR=8081
NGROK_PUBLIC_URL=

# e-Claim NHSO (ดาวน์โหลด REP สิทธิ OFC) — อย่า commit รหัสจริง
CGD_ECLAIM_BASE_URL=https://eclaim.nhso.go.th
CGD_ECLAIM_USERNAME=
CGD_ECLAIM_PASSWORD=
CGD_ECLAIM_LOGIN_PATH=/webComponent/LoginSSOAction.do
CGD_ECLAIM_VALIDATION_PATH=/webComponent/validation/ValidationMainAction.do?maininscl=ofc
CGD_ECLAIM_TIMEOUT=90
CGD_ECLAIM_SESSION_TTL=25
CGD_ECLAIM_VERIFY_SSL=false
CGD_ECLAIM_REP_FILENAME_PREFIX=rep_eclaim_14689_OPCS
CGD_STM_FILENAME_PREFIX=STM_14689_OP

# IM Timesheet ← Google Sheet ลงเวลาปฎิบัติงาน
IM_TIMESHEET_GOOGLE_SHEET_ID=1N_JbHz1R2N0yvC2c8Em5fFNcCDPDXJc5UNpRsSBxRdk
IM_TIMESHEET_GOOGLE_SHEET_GID=521989679
IM_TIMESHEET_GOOGLE_SHEET_TABS=รายงานการทำงาน,WorkLogs
# แนะนำ: Deploy scripts/google-apps/im-timesheet-api.gs แล้วใส่ URL
IM_TIMESHEET_GAS_URL=
IM_TIMESHEET_GAS_TOKEN=
# หรือวาง JSON ของ Service Account แล้วแชร์ชีตให้ client_email
GOOGLE_SERVICE_ACCOUNT_JSON=
# Windows/XAMPP ที่ไม่มี CA bundle จะลองใช้ curl-ca-bundle.crt อัตโนมัติ แล้วค่อยข้าม verify ถ้ายัง error 60
IM_TIMESHEET_VERIFY_SSL=true

# HOSxP สำรองข้อมูล (คนละเครื่องกับ HOSXP_DB_* ที่ใช้รายงาน)
# แนะนำ username = smh_backup (SELECT/SHOW VIEW/TRIGGER/EVENT/LOCK TABLES) ไม่ใช้ sa
HOSXP_BACKUP_DB_HOST=192.168.1.191
HOSXP_BACKUP_DB_PORT=3306
HOSXP_BACKUP_DB_DATABASE=hos
HOSXP_BACKUP_DB_USERNAME=sa
HOSXP_BACKUP_DB_PASSWORD=sa
HOSXP_BACKUP_KEEP=3
APPDB_BACKUP_KEEP=3
# DB_BACKUP_KEEP=3
HOSXP_BACKUP_DUMP_BIN=D:\Xampp\mysql\bin\mysqldump.exe
# HOSXP_BACKUP_PATH=
# สำรอง app_db ใช้ DB_* ชุดเดียวกับแอป เก็บโฟลเดอร์เดียวกับ HOSxP เวลา 05:00
# แต่ละชุดเก็บไม่เกิน 3 ไฟล์ล่าสุด (เกินแล้วลบของเก่าอัตโนมัติ)

# หน้าตรวจสอบเซิร์ฟเวอร์ — ชี้เครื่อง HIS จริง ไม่ใช้ HOSXP_DB_HOST (เครื่องรายงาน)
SERVER_MONITOR_HOST=192.168.1.191
SERVER_MONITOR_NAME="HOSxP Server"

# FortiGate F100 REST API (Bearer token — อย่า commit ค่าจริง)
FORTIGATE_ENABLED=true
FORTIGATE_HOST=https://192.168.100.99
FORTIGATE_API_TOKEN=
FORTIGATE_VERIFY_SSL=false
FORTIGATE_LOG_RETENTION_DAYS=90
# ลบ log เก่าเพิ่มเมื่อขนาดตาราง fortigate_* รวมเกินค่านี้ (GB)
FORTIGATE_LOG_MAX_GB=35
# ปิดไว้ก่อนถ้าแจ้งเตือนใน chat เยอะเกินไป — เปิดกลับเป็น true เมื่อพร้อม
FORTIGATE_NOTIFY_CHAT=false
# CSOC / log collectors — no chat alerts, excluded from top_devices & alert scopes
FORTIGATE_IGNORE_IPS=192.168.77.100
# FORTIGATE_WEB_DENY_PATTERNS=porn,gambling,malware,phishing
# FORTIGATE_WEB_WATCH_PATTERNS=social media,streaming media,games
# FORTIGATE_HOST_MAP=192.168.1.10:PC-OPD,192.168.1.11:Nurse-Station

# FortiGate Syslog → web app (run on 192.168.1.214): php artisan fortigate:syslog-listen
FORTIGATE_SYSLOG_ENABLED=true
FORTIGATE_SYSLOG_LISTEN_HOST=0.0.0.0
FORTIGATE_SYSLOG_LISTEN_PORT=5514
FORTIGATE_SYSLOG_NOTIFY=false
# interesting | denied | all
FORTIGATE_SYSLOG_TRAFFIC_MODE=interesting

# Threat Intelligence (free feeds; abuse.ch needs free Auth-Key from https://auth.abuse.ch/)
THREAT_INTEL_ENABLED=true
ABUSECH_AUTH_KEY=
# PhishTank: สมัครใหม่ปิดอยู่ — ระบบดึง CSV.gz สาธารณะได้โดยไม่ต้องมีคีย์
# ถ้ามี application key เก่า ให้ใส่ด้านล่างเพื่อลด rate-limit
# PHISHTANK_API_KEY=
# TI_FEED_PHISHTANK=true
# TI_PHISHTANK_MAX=8000
# TI_THAI_DOMAINS=huay.com,casino-th.com
# TI_CUSTOM_DOMAINS=facebook.com,youtube.com
# TI_CUSTOM_IPS=

# ตรวจจับพฤติกรรมผิดปกติ → แจ้งแชทศูนย์สารสนเทศ (FSHH Chat)
SECURITY_MONITOR_ENABLED=true
SECURITY_MONITOR_NOTIFY_CHAT=true
SECURITY_MONITOR_WINDOW_MINUTES=15
SECURITY_MONITOR_FAILED_LOGINS=8
SECURITY_MONITOR_FORBIDDEN=20
SECURITY_MONITOR_EXPORTS=8
SECURITY_MONITOR_PATIENT_LOOKUPS=40
SECURITY_MONITOR_SUSPICIOUS=3
SECURITY_MONITOR_ALERT_COOLDOWN=30

# Mask CID + นามสกุลผู้ป่วยในทุก Inertia/JSON (ระบบใหม่ภายใต้ web middleware จะถูก mask อัตโนมัติ)
# ยกเว้นเฉพาะ route ใน config/pii.php raw_route_names (เช่น กรอกโปรไฟล์เจ้าหน้าที่)
PII_MASK_ENABLED=true

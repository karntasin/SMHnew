APP_NAME=SMH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=react_stater_kits
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LINE Login + Messaging
LINE_INTEGRATION_ENABLED=true
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_OAUTH_REDIRECT=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_WELCOME_MESSAGE=
LINE_OA_ADD_FRIEND_URL=

# HTTPS tunnel — quick = *.trycloudflare.com ชั่วคราว | named = subdomain ถาวรของโดเมนคุณ
TUNNEL_DRIVER=cloudflare
CLOUDFLARED_BIN=
CLOUDFLARE_TUNNEL_MODE=quick
# ตัวอย่าง: smh.hospital.go.th (มาจาก Zero Trust → Tunnels → Public Hostname)
CLOUDFLARE_PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_CONFIG=deploy/cloudflare/config.yml
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_BIN=
NGROK_ADDR=8081
NGROK_PUBLIC_URL=

# e-Claim NHSO (ดาวน์โหลด REP สิทธิ OFC) — อย่า commit รหัสจริง
CGD_ECLAIM_BASE_URL=https://eclaim.nhso.go.th
CGD_ECLAIM_USERNAME=
CGD_ECLAIM_PASSWORD=
CGD_ECLAIM_LOGIN_PATH=/webComponent/LoginSSOAction.do
CGD_ECLAIM_VALIDATION_PATH=/webComponent/validation/ValidationMainAction.do?maininscl=ofc
CGD_ECLAIM_TIMEOUT=90
CGD_ECLAIM_SESSION_TTL=25
CGD_ECLAIM_VERIFY_SSL=false
CGD_ECLAIM_REP_FILENAME_PREFIX=rep_eclaim_14689_OPCS
CGD_STM_FILENAME_PREFIX=STM_14689_OP
